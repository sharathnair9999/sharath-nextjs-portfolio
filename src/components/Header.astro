---
import Icon from './Icon.astro';
import { site } from '@/lib/site';
---

<header
  data-header
  class="sticky top-0 z-40 border-b border-transparent bg-bg/80 backdrop-blur-md transition-colors duration-300 data-scrolled:border-border"
  transition:persist
>
  <!-- Page scroll progress; width is set on scroll by initScrollProgress in scripts/main.ts. -->
  <div
    data-scroll-progress
    class="pointer-events-none absolute inset-x-0 -bottom-px h-0.5 origin-left bg-linear-to-r from-accent/50 to-accent"
    style="transform: scaleX(0)"
    aria-hidden="true"
  ></div>
  <div class="mx-auto flex h-16 max-w-3xl items-center justify-between gap-4 px-5 sm:px-8">
    <a href="/" class="group flex items-center gap-2.5 font-medium tracking-tight">
      <span
        class="grid size-8 place-items-center rounded-full bg-fg font-mono text-xs font-medium text-bg transition-transform duration-300 group-hover:-rotate-6"
        aria-hidden="true"
      >
        {site.name
          .split(' ')
          .map((p) => p[0])
          .join('')}
      </span>
      <span class="sr-only sm:not-sr-only">{site.name}</span>
    </a>

    <nav aria-label={site.ui.primaryNav} class="hidden sm:block">
      <ul class="flex items-center gap-1 text-sm">
        {site.nav.map((item) => (
          <li>
            <a
              href={item.href}
              data-nav-link
              class="rounded-full px-3 py-1.5 text-muted transition-colors hover:text-fg aria-[current]:bg-surface-2 aria-[current]:text-fg"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-1">
      <button type="button" class="icon-btn" data-theme-toggle aria-label={site.ui.themeToggle}>
        <Icon name="sun" class="hidden dark:block" />
        <Icon name="moon" class="dark:hidden" />
      </button>
      <button type="button" class="icon-btn sm:hidden" popovertarget="mobile-nav" aria-label={site.ui.menu}>
        <Icon name="menu" />
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    popover
    aria-label={site.ui.mobileNav}
    class="mobile-nav inset-x-4 top-18 m-0 w-auto rounded-2xl border border-border bg-surface p-2 text-fg shadow-card sm:hidden"
  >
    <ul class="grid">
      {site.nav.map((item) => (
        <li>
          <a href={item.href} class="block rounded-xl px-4 py-3 text-base hover:bg-surface-2">
            {item.label}
          </a>
        </li>
      ))}
      <li>
        <a href={site.resume.href} class="block rounded-xl px-4 py-3 text-base hover:bg-surface-2">
          {site.resume.label}
        </a>
      </li>
    </ul>
  </nav>
</header>

<style>
  .mobile-nav {
    opacity: 0;
    transform: translateY(-6px) scale(0.98);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      overlay 0.2s allow-discrete,
      display 0.2s allow-discrete;
  }
  .mobile-nav:popover-open {
    opacity: 1;
    transform: none;
  }
  @starting-style {
    .mobile-nav:popover-open {
      opacity: 0;
      transform: translateY(-6px) scale(0.98);
    }
  }
  .mobile-nav::backdrop {
    background: oklch(0 0 0 / 0.15);
  }
</style>
