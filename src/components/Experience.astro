---
import { getCollection } from 'astro:content';
import Section from './Section.astro';
import Icon from './Icon.astro';
import StackLine from './StackLine.astro';
import { site } from '@/lib/site';
import { formatRange, sortKey } from '@/lib/dates';

const jobs = (await getCollection('experience')).sort(
  (a, b) =>
    sortKey(b.data.end).localeCompare(sortKey(a.data.end)) || b.data.start.localeCompare(a.data.start),
);
---

<Section {...site.sections.experience}>
  <!-- The path fills as you scroll (see initTimeline in scripts/main.ts); stops light up as the line reaches them. -->
  <div class="relative" data-timeline>
    <div class="absolute top-2 bottom-0 left-[11px] w-px bg-border sm:left-[15px]" aria-hidden="true"></div>
    <div
      class="timeline-fill absolute top-2 left-[10.5px] w-[2px] rounded-full bg-linear-to-b from-accent/30 to-accent sm:left-[14.5px]"
      aria-hidden="true"
    >
      <span class="absolute -bottom-1 -left-[2.5px] size-[7px] rounded-full bg-accent shadow-[0_0_14px_2px_var(--accent)]"></span>
    </div>

    <ol class="space-y-16">
      {jobs.map(({ data: job }) => (
        <li>
          <div class="group/stop relative pl-9 sm:pl-12" data-stop data-reveal>
            <span
              data-node
              class="absolute top-0.5 left-0 grid size-6 place-items-center sm:top-0 sm:size-8 rounded-full border border-border bg-bg transition-colors duration-500 group-data-active/stop:border-accent group-data-active/stop:bg-accent-soft"
              aria-hidden="true"
            >
              <span class="size-2 rounded-full bg-subtle transition-all duration-500 group-data-active/stop:scale-125 group-data-active/stop:bg-accent" />
            </span>
            <p class="pt-1.5 font-mono text-xs text-subtle">
              <time datetime={job.start}>{formatRange(job.start, job.end, site.ui.present)}</time>
            </p>
            <h3 class="mt-2 text-xl font-semibold tracking-tight">
              {job.url ? (
                <a
                  href={job.url}
                  class="link group inline-flex items-center gap-1"
                  target="_blank"
                  rel="noopener"
                >
                  {job.company}
                  <Icon
                    name="arrow-up-right"
                    size={15}
                    class="text-subtle transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                  />
                </a>
              ) : (
                job.company
              )}
            </h3>
            <p class="mt-1 text-sm text-muted">
              {job.role} · {job.location}
            </p>
            <p class="mt-4 max-w-xl text-fg/90">{job.summary}</p>

            {job.highlights && (
              <ul class="mt-4 max-w-xl space-y-2 text-muted">
                {job.highlights.map((h) => (
                  <li class="relative pl-4 before:absolute before:top-[0.7em] before:left-0 before:size-1 before:rounded-full before:bg-accent">
                    {h}
                  </li>
                ))}
              </ul>
            )}
            {job.stack && <StackLine items={job.stack} class="mt-4" />}
          </div>

          {job.engagements && (
            <ol class="mt-8 space-y-5">
              {job.engagements.map((e) => (
                <li class="group/stop relative pl-9 sm:pl-12" data-stop data-reveal>
                  <span
                    data-node
                    class="absolute top-7 left-[6px] size-[11px] sm:left-[10px] rounded-full border border-border bg-bg transition-colors duration-500 group-data-active/stop:border-accent group-data-active/stop:bg-accent"
                    aria-hidden="true"
                  />
                  <span
                    class="absolute top-[33px] left-[17px] h-px w-[19px] sm:left-[21px] sm:w-[27px] bg-border transition-colors duration-500 group-data-active/stop:bg-accent"
                    aria-hidden="true"
                  />
                  <article class="rounded-2xl border border-border bg-surface p-4 transition duration-500 group-data-active/stop:border-accent/30 sm:p-6">
                    <p class="flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-xs text-subtle">
                      {e.client && (
                        <span class="rounded-full bg-accent-soft px-2 py-0.5 text-accent">
                          {site.ui.client} · {e.client}
                        </span>
                      )}
                      <span>{e.role}</span>
                      <span aria-hidden="true">·</span>
                      <time datetime={e.start}>{formatRange(e.start, e.end, site.ui.present)}</time>
                    </p>
                    <h4 class="mt-3 text-lg font-medium tracking-tight">
                      {e.url ? (
                        <a href={e.url} class="link" target="_blank" rel="noopener">
                          {e.name}
                        </a>
                      ) : (
                        e.name
                      )}
                    </h4>
                    <p class="mt-2 text-muted">{e.summary}</p>
                    <ul class="mt-4 space-y-2 text-[0.95rem] text-muted">
                      {e.highlights.map((h) => (
                        <li class="relative pl-4 before:absolute before:top-[0.7em] before:left-0 before:size-1 before:rounded-full before:bg-accent">
                          {h}
                        </li>
                      ))}
                    </ul>
                    <StackLine items={e.stack} class="mt-4" />
                  </article>
                </li>
              ))}
            </ol>
          )}
        </li>
      ))}
    </ol>
  </div>

  <p class="mt-14 pl-9 sm:pl-12" data-reveal>
    <a
      href={site.resume.href}
      class="link group inline-flex items-center gap-1 font-medium"
      target="_blank"
      rel="noopener"
    >
      {site.hero.secondaryCta.label}
      <Icon
        name="arrow-up-right"
        size={16}
        class="transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
      />
    </a>
  </p>
</Section>
