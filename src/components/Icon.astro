export type IconName = keyof typeof stroke | keyof typeof fill;

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  label?: string;
}

const { name, size = 18, class: className, label } = Astro.props;
const isFill = name in fill;
const body = isFill ? fill[name as keyof typeof fill] : stroke[name as keyof typeof stroke];
const a11y = label ? { role: 'img' as const, 'aria-label': label } : { 'aria-hidden': 'true' as const };
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  class={className}
  fill={isFill ? 'currentColor' : 'none'}
  stroke={isFill ? 'none' : 'currentColor'}
  stroke-width={isFill ? undefined : 1.75}
  stroke-linecap="round"
  stroke-linejoin="round"
  focusable="false"
  {...a11y}
  set:html={body}
/>
