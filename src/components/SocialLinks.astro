---
import Icon from './Icon.astro';
import { site } from '@/lib/site';
interface Props {
  class?: string;
}
---

<ul class:list={['flex items-center gap-1', Astro.props.class]}>
  {site.socials.map((social) => (
    <li>
      <a
        href={social.href}
        class="icon-btn"
        rel="me noopener"
        target="_blank"
        aria-label={`${social.label} (${site.ui.newTab})`}
        title={social.label}
      >
        <Icon name={social.id === 'email' ? 'mail' : social.id} size={16} />
      </a>
    </li>
  ))}
</ul>
