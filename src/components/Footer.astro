---
import Icon from './Icon.astro';
import SocialLinks from './SocialLinks.astro';
import { site } from '@/lib/site';
const year = new Date().getFullYear();
---

<footer class="mx-auto mt-8 max-w-3xl px-5 pb-12 sm:px-8">
  <div class="flex flex-col gap-6 border-t border-border pt-8 sm:flex-row sm:items-center sm:justify-between">
    <div class="space-y-1 text-sm text-muted">
      <p>
        © {year} {site.name}
      </p>
      <p>
        {site.footer.note}{' '}
        <a href={site.footer.source.href} class="link text-fg" rel="noopener">
          {site.footer.source.label}
        </a>
      </p>
    </div>
    <div class="flex items-center gap-1">
      <SocialLinks />
      <a href="#main" class="icon-btn" aria-label={site.ui.backToTop}>
        <Icon name="arrow-up" />
      </a>
    </div>
  </div>
</footer>
