---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  intro?: string;
}
const { id, eyebrow, title, intro } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`} class="border-t border-border py-16 sm:py-24">
  <header class="mb-10 max-w-xl" data-reveal>
    <p class="eyebrow mb-2" aria-hidden="true">
      {eyebrow}
    </p>
    <h2 id={`${id}-title`} class="text-2xl font-semibold tracking-tight sm:text-3xl">
      {title}
    </h2>
    {intro && <p class="mt-3 text-muted">{intro}</p>}
  </header>
  <slot />
</section>
